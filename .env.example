# Copy to .env and fill in. .env is gitignored – never commit real values.

# --- Postgres (shared by n8n and radar-api) ---
POSTGRES_USER=radar
POSTGRES_PASSWORD=change-me
POSTGRES_DB=radar

# --- n8n ---
# Any long random string. Encrypts stored credentials; changing it later
# makes existing n8n credentials unreadable.
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
# Created in n8n under Settings > n8n API; used by scripts/tasks.py import-workflows.
N8N_API_KEY=

# --- HTTP etiquette towards the data sources ---
# Sent with every request to BSI, CISA, FIRST and ENISA. Put a real contact here.
HTTP_USER_AGENT=Schwachstellen-Radar/0.1 (+contact: you@example.com)

# --- LLM ---
# Zero-cost setup: only free providers. Same prompts, same JSON schema and the
# same Pydantic validation for every provider (D-015).
#   ollama  local model on this machine. DEFAULT: used for the demo and for
#           anything that could hold real customer data.
#   groq    Groq free tier. Option B, for speed during development and eval runs.
LLM_PROVIDER=ollama

# Host Ollama, reached from inside the containers (see README).
# With the compose profile `local-llm` use http://ollama:11434 instead.
OLLAMA_BASE_URL=http://host.docker.internal:11434
# The same open-weight model on both providers (D-016).
OLLAMA_MODEL=gpt-oss:20b

# Free tier only, no credit card. Leave empty to run without Groq: everything
# then uses Ollama, without errors.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Hard spending limit per eval run; the run aborts when it is reached.
# Both providers above cost 0 EUR; the cap guards against a paid one being added.
EVAL_COST_CAP_EUR=5

# --- Mail (everything goes to Mailpit, nothing leaves the machine) ---
MAIL_FROM=radar@example.invalid
ANALYST_NAME=Analyst Demo
ANALYST_EMAIL=analyst@example.invalid
