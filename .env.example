# Copy to .env and fill in. .env is gitignored – never commit real values.

# --- Postgres (shared by n8n and radar-api) ---
POSTGRES_USER=radar
POSTGRES_PASSWORD=change-me
POSTGRES_DB=radar

# --- n8n ---
# Any long random string. Encrypts stored credentials; changing it later
# makes existing n8n credentials unreadable.
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
# Created in n8n under Settings > n8n API; used by scripts/tasks.py import-workflows.
N8N_API_KEY=

# --- HTTP etiquette towards the data sources ---
# Sent with every request to BSI, CISA, FIRST and ENISA. Put a real contact here.
HTTP_USER_AGENT=Schwachstellen-Radar/0.1 (+contact: you@example.com)

# --- LLM ---
# anthropic | ollama
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Model names are deliberately not hard-coded in the code (D-012).
LLM_MODEL_MATCH=claude-haiku-4-5-20251001
LLM_MODEL_DRAFT=claude-sonnet-5-5
# Host Ollama, reached from inside the containers (see README).
# With the compose profile `local-llm` use http://ollama:11434 instead.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=
# Hard spending limit per eval run; the run aborts when it is reached.
EVAL_COST_CAP_EUR=5

# --- Mail (everything goes to Mailpit, nothing leaves the machine) ---
MAIL_FROM=radar@example.invalid
ANALYST_NAME=Analyst Demo
ANALYST_EMAIL=analyst@example.invalid
